FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for LiveKit agents (STT/TTS plugins often need shared libs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libglib2.0-0 \
    libasound2-dev \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# LiveKit worker usually runs as a module
ENV PYTHONUNBUFFERED=1

RUN adduser --disabled-password --gecos "" appuser
USER appuser

CMD ["python3", "-m", "app.voice.worker", "dev"]